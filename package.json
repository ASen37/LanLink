{
  "name": "lanlink",
  "version": "1.0.0",
  "private": true,
  "description": "LanLink - LAN end-to-end encrypted file transfer with a desktop GUI",
  "author": "ASen37",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev:a": "node src/server.js --data dev/node-a --ui-port 7421 --tcp-port 7423 --discovery-port 7424 --name Node-A --auto-trust",
    "dev:b": "node src/server.js --data dev/node-b --ui-port 7431 --tcp-port 7433 --discovery-port 7424 --name Node-B --auto-trust",
    "test": "node test/integration.js",
    "test:guest": "node test/guest.js",
    "bench": "node test/bench.js",
    "dist:win": "electron-packager . LanLink --platform=win32 --arch=x64 --out=bin --overwrite --icon=build/icon.ico",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.asen.lanlink",
    "productName": "LanLink",
    "copyright": "Copyright © 2026 ASen37",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "bin/installer",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LanLink",
      "artifactName": "LanLink-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    }
  }
}
